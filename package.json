{
  "name": "@svnbjrn/ironmaw",
  "version": "0.1.0",
  "description": "IRONMAW — the Wormian Bones design system. A system of uncommon parts: charcoal, teal, rust and slate for the Application Assistant library and reader.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./styles.css": "./dist/tokens/index.css",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./tokens/*.json": "./dist/tokens/resolved/*.json"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run tokens && pnpm run fonts && pnpm run assets && svelte-package && publint",
    "tokens": "node scripts/build-tokens.mjs && node scripts/build-egui.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "assets": "node scripts/build-assets.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "design-sync:build": "pnpm run build && node .design-sync/react-adapter/build.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/svelte-vite": "^10.4.6",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/svelte": "^5.2.0",
    "@types/node": "^24.0.0",
    "jsdom": "^25.0.0",
    "publint": "^0.2.0",
    "storybook": "^10.4.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
