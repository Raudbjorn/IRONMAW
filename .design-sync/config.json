{
  "projectId": "1dff7fc2-dd42-4e4d-a56b-0c480c101b40",
  "pkg": "@svnbjrn/ironmaw",
  "globalName": "Ironmaw",
  "shape": "storybook",
  "storybookConfigDir": ".storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "buildCmd": "pnpm run build && node .design-sync/react-adapter/build.mjs",
  "entry": ".design-sync/react-dist/index.js",
  "cssEntry": "index.css",
  "tokensPkg": "@svnbjrn/ironmaw",
  "tokensGlob": "dist/tokens/*.css",
  "extraFonts": [
    "../../dist/tokens/fonts.css"
  ],
  "provider": {
    "component": "ThemeRoot",
    "props": {
      "theme": "oxide"
    }
  },
  "overrides": {
    "Text": {
      "cardMode": "column"
    },
    "NavBar": {
      "cardMode": "column"
    },
    "DocumentEntry": {
      "cardMode": "column"
    },
    "SourceEntry": {
      "cardMode": "column"
    },
    "SearchField": {
      "cardMode": "column"
    },
    "Panel": {
      "cardMode": "column",
      "primaryStory": "ReaderHeader"
    },
    "Icon": {
      "cardMode": "column",
      "primaryStory": "AllIcons"
    },
    "DocHeader": {
      "cardMode": "column",
      "primaryStory": "FullPage"
    },
    "PageSheet": {
      "cardMode": "column",
      "primaryStory": "A4Page"
    },
    "PageAnnotation": {
      "cardMode": "column",
      "primaryStory": "OnPage"
    },
    "PageCanvas": {
      "cardMode": "column",
      "primaryStory": "WithToolbarAndOverlay"
    },
    "Workspace": {
      "cardMode": "column",
      "primaryStory": "EditorFrame"
    },
    "AppHeader": {
      "cardMode": "column",
      "primaryStory": "FullEditorBar"
    },
    "Menu": {
      "cardMode": "single",
      "primaryStory": "TextTriggerTwoColumns"
    },
    "Button": {
      "cardMode": "column",
      "primaryStory": "Primary"
    }
  },
  "titleMap": {
    "Colors": null,
    "Typography": null,
    "Geometry": null,
    "CV editor": null
  },
  "readmeHeader": ".design-sync/conventions.md"
}
