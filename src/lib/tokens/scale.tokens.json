{
  "$description": "Edition-agnostic scale: brand anchors, typography, spacing, geometry, layering, breakpoints, shadows. Emitted into @layer wm.base at :root. Editions restyle colour; they never move stacking contexts, layout thresholds or the chamfer.",
  "brand": {
    "$type": "color",
    "$description": "The four declared anchors from identity board B2, verbatim. Use for the identity itself (Mark, brand moments); components use the semantic edition tokens instead.",
    "teal": { "$value": "#3CA0A0" },
    "slate": { "$value": "#5F7E8F" },
    "rust": { "$value": "#D0602B" },
    "charcoal": { "$value": "#0F1416" }
  },
  "scale": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": ["Inter", "system-ui", "sans-serif"],
      "$description": "Interface and prose. Never letterspaced or uppercased for titles, excerpts, warnings or Icelandic prose."
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": ["Iosevka", "ui-monospace", "Courier New", "monospace"],
      "$description": "Paths, locators, technical values."
    },
    "font-display": {
      "$type": "fontFamily",
      "$value": ["Rajdhani", "system-ui", "sans-serif"],
      "$description": "Condensed, widely spaced uppercase lettering for short labels and brand moments only (Kicker, Button, Tabs, NavBar). OFL; full Icelandic coverage verified."
    },
    "font-weight-normal": { "$type": "fontWeight", "$value": 400, "$description": "Weight ramp tuned for Inter Variable; names are roles, not CSS keywords." },
    "font-weight-medium": { "$type": "fontWeight", "$value": 550 },
    "font-weight-semibold": { "$type": "fontWeight", "$value": 600 },
    "font-weight-bold": { "$type": "fontWeight", "$value": 650 },
    "display-weight": { "$type": "fontWeight", "$value": 600, "$description": "Rajdhani SemiBold for labels." },
    "display-weight-bold": { "$type": "fontWeight", "$value": 700, "$description": "Rajdhani Bold for the wordmark and primary actions." },
    "tracking-display": { "$type": "dimension", "$value": { "value": 0.14, "unit": "em" }, "$description": "Letterspacing for uppercase display labels." },
    "tracking-wide": { "$type": "dimension", "$value": { "value": 0.08, "unit": "em" } },
    "space-0": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
    "space-1": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
    "space-2": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
    "space-3": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
    "space-4": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
    "space-6": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
    "space-8": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
    "space-12": { "$type": "dimension", "$value": { "value": 3, "unit": "rem" } },
    "radius-sm": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
    "radius-md": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "radius-lg": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
    "chamfer": { "$type": "dimension", "$value": { "value": 10, "unit": "px" }, "$description": "The clipped corner on primary controls (B3's angular button ends). One size; never scaled per component." },
    "tick": { "$type": "dimension", "$value": { "value": 18, "unit": "px" }, "$description": "Length of the short rust tick under labels (B2's accent dash)." },
    "control-sm": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "control-md": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
    "control-lg": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
    "control-xs": { "$type": "dimension", "$value": { "value": 28, "unit": "px" }, "$description": "Compact in-row controls: chips, row toggles, menu triggers inside lists." },
    "row": { "$type": "dimension", "$value": { "value": 48, "unit": "px" }, "$description": "Minimum height of a simple result row." },
    "measure": { "$type": "dimension", "$value": { "value": 68, "unit": "ch" }, "$description": "Comfortable prose width in the reader." },
    "field-label-gap": { "$type": "dimension", "$value": { "value": 8, "unit": "px" }, "$description": "Label to its control. Text must never crowd its field (owner review 2026-10-15)." },
    "field-gap": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "One field (hint included) to the next field's label." },
    "paragraph-gap": { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$description": "Space between paragraphs and between stacked multi-line items." },
    "control-pad-x": { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$description": "Inline padding inside text fields and buttons; text never closer to a box edge." },
    "field-pad-y": { "$type": "dimension", "$value": { "value": 10, "unit": "px" }, "$description": "Block padding inside multi-line fields." },
    "icon-sm": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "Icon box sizes. Icons are drawn on a 24-unit grid with one stroke weight." },
    "icon-md": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
    "icon-lg": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "sidebar": { "$type": "dimension", "$value": { "value": 320, "unit": "px" }, "$description": "Default width of a workspace sidebar (editor, inspector)." },
    "page-a4-width": { "$type": "dimension", "$value": { "value": 794, "unit": "px" }, "$description": "A4 at 96 dpi (210 mm). Page sheets scale with zoom; the physical ratio never changes." },
    "page-a4-height": { "$type": "dimension", "$value": { "value": 1123, "unit": "px" } },
    "page-letter-width": { "$type": "dimension", "$value": { "value": 816, "unit": "px" }, "$description": "US Letter at 96 dpi (8.5 in)." },
    "page-letter-height": { "$type": "dimension", "$value": { "value": 1056, "unit": "px" } },
    "page-margin": { "$type": "dimension", "$value": { "value": 56, "unit": "px" }, "$description": "Inner margin of a document page (about 15 mm)." },
    "fs-xs": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
    "fs-sm": { "$type": "dimension", "$value": { "value": 0.8125, "unit": "rem" } },
    "fs-base": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" }, "$description": "14px list text." },
    "fs-lg": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" }, "$description": "16px reading text." },
    "fs-xl": { "$type": "dimension", "$value": { "value": 1.125, "unit": "rem" } },
    "fs-2xl": { "$type": "dimension", "$value": { "value": 1.375, "unit": "rem" } },
    "fs-3xl": { "$type": "dimension", "$value": { "value": 1.75, "unit": "rem" } },
    "fs-display": { "$type": "dimension", "$value": { "value": 2.25, "unit": "rem" } },
    "lh-tight": { "$type": "number", "$value": 1.15 },
    "lh-normal": { "$type": "number", "$value": 1.5 },
    "lh-relaxed": { "$type": "number", "$value": 1.65 },
    "z-base": { "$type": "number", "$value": 0 },
    "z-elevated": { "$type": "number", "$value": 10 },
    "z-sticky": { "$type": "number", "$value": 100 },
    "z-dropdown": { "$type": "number", "$value": 1000 },
    "z-overlay": { "$type": "number", "$value": 2000 },
    "bp-sm": { "$type": "dimension", "$value": { "value": 640, "unit": "px" }, "$description": "Breakpoints — canonical reference. CSS vars cannot be used inside @media conditions, so component queries hardcode these px values verbatim." },
    "bp-md": { "$type": "dimension", "$value": { "value": 768, "unit": "px" } },
    "bp-lg": { "$type": "dimension", "$value": { "value": 1024, "unit": "px" } },
    "bp-xl": { "$type": "dimension", "$value": { "value": 1440, "unit": "px" } },
    "shadow-sm": { "$type": "shadow", "$value": { "color": "rgb(0 0 0 / 0.35)", "offsetX": "0px", "offsetY": "1px", "blur": "2px" } },
    "shadow-md": { "$type": "shadow", "$value": { "color": "rgb(0 0 0 / 0.4)", "offsetX": "0px", "offsetY": "6px", "blur": "16px" } }
  }
}
